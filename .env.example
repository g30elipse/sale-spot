# Supabase sync — copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Leave unset to run the till local-only (no sync).
#
# One-time Supabase setup:
#   1. Create a project at supabase.com
#   2. Run supabase/migrations/*.sql in the SQL editor (or `supabase db push`)
#   3. Add {{ .Token }} to the Magic Link email template, so the 6-digit code is sent
#   4. Add this app's origin to Authentication → URL Configuration
#
# Only these two public values belong here. Never commit the service-role key or
# the database password.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
